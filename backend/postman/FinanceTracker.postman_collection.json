{
  "info": {
    "name": "FinanceTracker API",
    "description": "FinanceTracker API collection for testing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "value",
        "value": "Bearer {{access_token}}",
        "type": "string"
      },
      {
        "key": "key",
        "value": "Authorization",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 開発環境用のヘッダーを自動追加",
          "if (pm.environment.get('use_dev_auth') === 'true') {",
          "    pm.request.headers.add({",
          "        key: 'X-Dev-User-ID',",
          "        value: pm.environment.get('dev_user_id') || 'auth0|dev-test-user-123'",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get Auth0 Token (Client Credentials)",
          "description": "Machine-to-Machine認証用のトークンを取得します。このエンドポイントを使用するには、Auth0でM2Mアプリケーションを作成する必要があります。",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// このリクエストは開発用ヘッダーを使用しない",
                  "pm.request.headers.remove('X-Dev-User-ID');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.environment.set('access_token', response.access_token);",
                  "    console.log('Token saved successfully');",
                  "} else {",
                  "    console.log('Token request failed:', pm.response.code, pm.response.json());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"YOUR_M2M_CLIENT_ID\",\n  \"client_secret\": \"YOUR_M2M_CLIENT_SECRET\",\n  \"audience\": \"{{auth0_audience}}\",\n  \"grant_type\": \"client_credentials\"\n}"
            },
            "url": {
              "raw": "https://{{auth0_domain}}/oauth/token",
              "protocol": "https",
              "host": ["{{auth0_domain}}"],
              "path": ["oauth", "token"]
            }
          }
        },
        {
          "name": "DEV: Skip Auth0 (Use Dev Header)",
          "description": "開発環境では、Auth0トークンの代わりにX-Dev-User-IDヘッダーを使用します。このリクエストは何もしませんが、開発フローの説明として含まれています。",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// 開発環境用の設定確認",
                  "console.log('開発用認証が有効です。');",
                  "console.log('使用中のユーザーID:', pm.environment.get('dev_user_id'));",
                  "console.log('');",
                  "console.log('全てのAPIリクエストに自動的にX-Dev-User-IDヘッダーが追加されます。');",
                  "console.log('実際のAuth0認証を使用する場合は、use_dev_authをfalseに設定してください。');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base_url}}/health",
              "host": ["{{api_base_url}}"],
              "path": ["health"]
            },
            "description": "このリクエストは実際には/healthエンドポイントを呼び出しますが、主な目的は開発用認証の説明です。"
          }
        },
        {
          "name": "Set Token Cookie",
          "description": "取得したトークンをHttpOnlyクッキーに保存",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"access_token\": \"{{access_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/token",
              "host": ["{{base_url}}"],
              "path": ["auth", "token"]
            }
          }
        },
        {
          "name": "Remove Token Cookie",
          "description": "HttpOnlyクッキーからトークンを削除",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/token",
              "host": ["{{base_url}}"],
              "path": ["auth", "token"]
            }
          }
        },
        {
          "name": "Check Auth",
          "description": "HttpOnlyクッキーから認証状態を確認",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/check",
              "host": ["{{base_url}}"],
              "path": ["auth", "check"]
            }
          }
        },
        {
          "name": "Get Auth User",
          "description": "認証済みユーザーの情報を取得",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/user",
              "host": ["{{base_url}}"],
              "path": ["auth", "user"]
            }
          }
        },
        {
          "name": "Login (Redirect)",
          "description": "Auth0のログインページへリダイレクト（ブラウザで開く）",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Logout",
          "description": "ログアウトしてクッキーをクリア",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
