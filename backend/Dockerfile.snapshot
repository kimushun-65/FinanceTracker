# Build stage
FROM golang:1.24-alpine AS builder

# 必要なツールのインストール
RUN apk update && apk add --no-cache \
    git \
    ca-certificates \
    tzdata \
    && rm -rf /var/cache/apk/*

# 作業ディレクトリ設定
WORKDIR /app

# Go modulesの依存関係を先にコピー（キャッシュ効率化）
COPY go.mod go.sum ./
RUN go mod download

# ソースコード全体をコピー
COPY . .

# スナップショットバッチのビルド
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o snapshot ./cmd/snapshot

# Runtime stage
FROM alpine:latest

# 必要な実行時パッケージのインストール
RUN apk --no-cache add ca-certificates tzdata

# タイムゾーン設定
ENV TZ=Asia/Tokyo
RUN cp /usr/share/zoneinfo/Asia/Tokyo /etc/localtime

# 作業ディレクトリ設定
WORKDIR /root/

# ビルド済みバイナリをコピー
COPY --from=builder /app/snapshot .

# .envファイルをコピー（オプション - ECSでは環境変数で設定することを推奨）
# COPY .env .

# スナップショットバッチを実行
CMD ["./snapshot"]
